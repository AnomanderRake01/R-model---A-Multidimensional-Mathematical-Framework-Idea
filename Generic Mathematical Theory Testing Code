This is a code which uses fast hashing and number chunking in order to be able to quickly run and make reproducable results for mathematical theory research.
This is not intended to be an absolute precision mathematical program, this is made in order to make sure you can look for patterns where precision doesn't matter in the big picture.

import hashlib
import json
from decimal import Decimal, getcontext


# --- ENGINE SETTINGS ---
getcontext().prec = 160  # 512-bit Emulation Depth
FRICTION = Decimal("1e-158")


class LedgerEngine:
    def __init__(self, seed):
        """Initializes the secure state and audit ledger."""
        self.current_state = Decimal(int(hashlib.sha256(seed.encode()).hexdigest(), 16))
        self.previous_digest = "0" * 128
        self.ledger = []


    def _get_states(self):
        """Generates lossless containers (Int, Float, Vector, Tensor)."""
        base = self.current_state
        return {
            "int": base,
            "float": base + (base * FRICTION),
            "vec": [base // Decimal(str(i + 1)) for i in range(8)],
            "ten": [[base if i == j else Decimal('0') for j in range(8)] for i in range(8)]
        }


    def process(self, step, model_func):
        """
        The Core Driver. 
        Accepts a model, applies its specific chunking, and logs to ledger.
        """
        states = self._get_states()
        
        # Execute External Model Logic
        # model_func must return: (new_state, chunk_size)
        raw_result, chunk_size = model_func(states)
        
        # Apply Adaptive Chunking / Grid-Locking
        c_size = Decimal(str(chunk_size))
        self.current_state = (Decimal(str(raw_result)) // c_size) * c_size
        
        # Security: 512-bit state verification
        digest = hashlib.sha3_512(str(self.current_state).encode()).hexdigest()
        
        # Immutable Record Entry
        entry = {
            "hash": digest,
            "parent": self.previous_digest,
            "state": str(self.current_state),
            "iteration": step,
            "resolution": str(c_size)
        }
        
        self.ledger.append(entry)
        self.previous_digest = digest
        return entry


