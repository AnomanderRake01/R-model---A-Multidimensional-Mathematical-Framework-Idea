import hashlib
from decimal import Decimal, getcontext

# --- DYNAMIC PRECISION SCALING ---
# We set precision to 200 to ensure 160-digit numbers have 
# a 40-digit "Noise Buffer" for Mantissa Drift to exist in.
getcontext().prec = 200 

class SymmetryEngine:
    def __init__(self, seed, friction_depth=180):
        self.seed = str(seed)
        # Friction exists deep in the mantissa, but within the precision buffer
        self.friction = Decimal(f"1e-{friction_depth}")
        self.current_state = Decimal(int(hashlib.sha256(self.seed.encode()).hexdigest(), 16))
        self.previous_digest = "0" * 128
        self.ledger = []

    def _apply_friction(self, val):
        """
        Creates the 'Perfect Tube'. Instead of rounding to zero, 
        it forces a non-associative drift in the micro-scale.
        """
        return val + (val * self.friction)

    def _get_states(self):
        base = self.current_state
        return {
            "int": base, # Discrete Core
            "float": self._apply_friction(base), # Drift Layer
            "vec": [base / Decimal(str(i + 1.25)) for i in range(8)], # Symmetry Projections
            "ten": [[base if i == j else self.friction for j in range(8)] for i in range(8)]
        }

    def process(self, step, model_func):
        states = self._get_states()
        
        # model_func returns: (result, chunk_size)
        raw_result, chunk_size = model_func(states)
        
        # ADAPTIVE CHUNKING:
        # If chunk_size is 'None', we treat it as an Exact State (No Loss).
        if chunk_size:
            c_size = Decimal(str(chunk_size))
            self.current_state = (Decimal(str(raw_result)) // c_size) * c_size
        else:
            self.current_state = Decimal(str(raw_result))

        digest = hashlib.sha3_512(str(self.current_state).encode()).hexdigest()
        
        entry = {
            "hash": digest,
            "parent": self.previous_digest,
            "iteration": step,
            "drift_active": self.current_state != raw_result
        }
        
        self.ledger.append(entry)
        self.previous_digest = digest
        return entry

# --- CLEAN PLUG & PLAY ---

def model_gate(s):
    """
    Logic Gate:
    To keep it 'Lossless', return None for chunk_size.
    To test 'Controlled Chaos', return a Decimal chunk_size.
    """
    # WRITE LOGIC HERE
    res = s['int'] 
    
    return res, "1e20" 

# --- EXECUTION ---
engine = SymmetryEngine(seed="ROOT_STABILITY_TEST")

for i in range(1, 6):
    report = engine.process(i, model_gate)
    print(f"Step {i} | Drift Detected: {report['drift_active']} | Hash: {report['hash'][:16]}")


